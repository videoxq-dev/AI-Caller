# Database
# localhost below is ONLY for native (non-container) development. In Docker Compose,
# use the Postgres SERVICE NAME on the same Docker network (e.g. postgres:5432).
# For hosted Postgres use the provider hostname and required TLS options. Do not
# expose PostgreSQL port 5432 to the public internet.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_caller

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Cloud deployments: use the externally reachable HTTPS app URL, NOT container localhost.
BETTER_AUTH_URL=http://localhost:3000

# Provider credential encryption
# Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Background jobs
PG_BOSS_SCHEMA=pgboss

# Transactional email (password reset, team invitations and welcome email).
# Configure separate SMTP fields, or use SMTP_URL below as an alternative.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=AI Caller <no-reply@example.com>
# SMTP_URL takes precedence when configured. Leave unset for separate SMTP fields.
# SMTP_URL=smtp://username:password@smtp.example.com:587

# JVZoo commerce
JVZOO_IPN_SECRET=replace-with-your-jvzipn-secret-key
JVZOO_CORE_PRODUCT_IDS=123456
STARTER_CREDITS=2500
# Bootstrap platform administrators by exact email. Durable admins can then be managed in-app.
PLATFORM_ADMIN_EMAILS=

# Stripe credit top-ups. Prefer a restricted server-side API key.
STRIPE_RESTRICTED_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Hosted AI used by "Our Credits". Keep the platform key server-side.
HOSTED_AI_PROVIDER=openai
HOSTED_AI_API_KEY=
HOSTED_AI_MODEL=gpt-5.6-luna
# Hosted requests are capped so the wallet can reserve a safe maximum before provider spend.
HOSTED_AI_MAX_OUTPUT_TOKENS=1200

# Hosted telephony. Telnyx is the managed phone-number provider for voice + SMS.
# The legacy HOSTED_SMS_TELNYX_* variables below remain as fallbacks during migration.
HOSTED_TELNYX_API_KEY=
HOSTED_TELNYX_WEBHOOK_PUBLIC_KEY=
# Public HTTPS origin of your app for carrier callbacks. Useful when BETTER_AUTH_URL is localhost.
# Leave blank when BETTER_AUTH_URL is already publicly reachable via HTTPS.
HOSTED_WEBHOOK_BASE_URL=
HOSTED_TELEPHONY_TARGET_MARGIN_BPS=5000

# Legacy Telnyx variable names are still accepted temporarily for deployment compatibility.
HOSTED_SMS_TELNYX_API_KEY=
HOSTED_SMS_TELNYX_WEBHOOK_PUBLIC_KEY=

# Calendar OAuth applications
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Cal.com API v2 versions are endpoint-specific in the current API.
CALCOM_BOOKINGS_API_VERSION=2026-02-25
CALCOM_SLOTS_API_VERSION=2024-09-04

# Meta Tech Provider / WhatsApp Embedded Signup
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v22.0
META_WEBHOOK_VERIFY_TOKEN=
META_PHONE_REGISTRATION_PIN=

# Logging
LOG_LEVEL=info

# Inbound voice
# Enable only after WSS/hosted OpenAI, billing, Telnyx live acceptance and DB migration.
VOICE_REALTIME_ENABLED=false
VOICE_GATEWAY_URL=
VOICE_GATEWAY_PORT=3002
VOICE_RECORDING_STORAGE_BACKEND=filesystem
VOICE_RECORDING_DIR=.data/recordings
VOICE_RECORDING_S3_BUCKET=
VOICE_RECORDING_S3_REGION=us-east-1
VOICE_RECORDING_S3_ENDPOINT=
VOICE_RECORDING_S3_ACCESS_KEY_ID=
VOICE_RECORDING_S3_SECRET_ACCESS_KEY=
