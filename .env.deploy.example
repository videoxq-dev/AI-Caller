# Copy to .env.deploy and replace ALL CHANGE_ME values; NEVER commit .env.deploy.
# This file is ONLY for manual -f compose.selfhost.yaml deployment.\n# DeployOS uses its own Config environment variables and default compose.yaml.\n# Manual self-hosted Compose creates NEW private PostgreSQL data in a volume.
# If you already have a database, do not replace it with an empty one accidentally.
POSTGRES_USER=ai_caller
POSTGRES_DB=ai_caller
# Generate a URL-safe password with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_SAME_RANDOM_HEX_PASSWORD
# The password below must MATCH POSTGRES_PASSWORD, and the host must be
# the Compose service "postgres", NOT localhost/127.0.0.1.
DATABASE_URL=postgresql://ai_caller:CHANGE_ME_SAME_RANDOM_HEX_PASSWORD@postgres:5432/ai_caller

# Actual public HTTPS origin seen by the browser, NOT an internal Docker URL.
BETTER_AUTH_URL=https://app.YOUR_DOMAIN.example
# openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=CHANGE_ME_TO_A_VALID_32_BYTE_BASE64_KEY

HOSTED_AI_PROVIDER=openai
HOSTED_AI_MODEL=gpt-5.6-luna
HOSTED_AI_API_KEY=
HOSTED_TELNYX_API_KEY=
HOSTED_TELNYX_WEBHOOK_PUBLIC_KEY=
# Leave blank when BETTER_AUTH_URL itself is publicly reachable over HTTPS.
HOSTED_WEBHOOK_BASE_URL=
VOICE_GATEWAY_URL=
VOICE_RECORDING_STORAGE_BACKEND=filesystem
VOICE_RECORDING_DIR=/app/.data/recordings

# Reverse proxy on same VM should target http://127.0.0.1:8080.
AI_CALLER_BIND_ADDRESS=127.0.0.1
AI_CALLER_HTTP_PORT=8080
LOG_LEVEL=info
